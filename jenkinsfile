pipeline {
    agent any

    environment {
        DOCKER_HUB_USER = 'nitishpaul'
        IMAGE_NAME      = 'react-hello-world'
        CONTAINER_NAME  = 'react-app-local'
        PORT_MAPPING    = '3000:80'
        KUBECONFIG      = 'C:\\Users\\Nitishpaul\\.kube\\config'
    }

    stages {
        stage('Checkout Code') {
            steps {
                echo '========================================'
                echo 'Checking out source code...'
                echo '========================================'
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                echo '========================================'
                echo 'Building Docker Image...'
                echo '========================================'
                bat "docker build -t %DOCKER_HUB_USER%/%IMAGE_NAME%:%BUILD_NUMBER% -t %DOCKER_HUB_USER%/%IMAGE_NAME%:latest ."
            }
        }

        stage('Push to Docker Hub') {
            steps {
                echo '========================================'
                echo 'Logging in & Pushing to Docker Hub...'
                echo '========================================'
                

                withCredentials([usernamePassword(credentialsId: 'docker-hub-credentials', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                    bat "docker login -u %DOCKER_USER% -p %DOCKER_PASS%"
                    bat "docker push %DOCKER_HUB_USER%/%IMAGE_NAME%:%BUILD_NUMBER%"
                    bat "docker push %DOCKER_HUB_USER%/%IMAGE_NAME%:latest"
                }
            }
        }

        stage('Deploy to Kubernetes (3 Pods + Kong)') {
            steps {
                echo '========================================'
                echo 'Deploying to Kubernetes Cluster (3 Pods)...'
                echo '========================================'
                bat '''
                    @echo off
                    set "KUBECONFIG=C:\\Users\\Nitishpaul\\.kube\\config"
                    echo Using KUBECONFIG: %KUBECONFIG%

                    echo [1/4] Applying Kubernetes Deployment, Service and ConfigMap...
                    kubectl apply -f k8s/react-deployment.yaml --kubeconfig="%KUBECONFIG%"

                    echo [2/4] Applying Kong API Gateway Ingress and CORS Plugin...
                    kubectl apply -f k8s/kong-ingress.yaml --kubeconfig="%KUBECONFIG%"

                    echo [3/4] Performing Zero-Downtime Rolling Update on 3 Pods...
                    kubectl rollout restart deployment/react-app --kubeconfig="%KUBECONFIG%"

                    echo [4/4] Waiting for all 3 Pods to be ready...
                    kubectl rollout status deployment/react-app --timeout=90s --kubeconfig="%KUBECONFIG%"

                    echo ========================================
                    echo Kubernetes Pods Status:
                    kubectl get pods -l app=react-app -o wide --kubeconfig="%KUBECONFIG%"
                    echo ========================================
                '''
            }
        }

    }

    post {
        success {
            echo '========================================'
            echo 'REACT CI/CD PIPELINE SUCCESSFUL'
            echo 'Docker Image Built : SUCCESS'
            echo 'Docker Hub Push   : SUCCESS'
            echo 'Kubernetes 3 Pods : DEPLOYED & HEALTHY'
            echo 'Kong Gateway Ingress: ACTIVE on http://localhost:8000'
            echo '========================================'
        }
        failure {
            echo '========================================'
            echo 'REACT CI/CD PIPELINE FAILED'
            echo '========================================'
            echo 'Please check Jenkins Console Logs.'
            echo '========================================'
        }
    }
}