pipeline {
    agent any

    environment {

        DOCKER_HUB_USER = 'nitishpaul'
        

        IMAGE_NAME      = 'react-hello-world'
        CONTAINER_NAME  = 'react-app-local'
        PORT_MAPPING    = '3000:80'
    }

    stages {
        stage('Checkout Code') {
            steps {
                echo '========================================'
                echo 'Checking out source code...'
                echo '========================================'
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                echo '========================================'
                echo 'Building Docker Image...'
                echo '========================================'
                bat "docker build -t %DOCKER_HUB_USER%/%IMAGE_NAME%:%BUILD_NUMBER% -t %DOCKER_HUB_USER%/%IMAGE_NAME%:latest ."
            }
        }

        stage('Push to Docker Hub') {
            steps {
                echo '========================================'
                echo 'Logging in & Pushing to Docker Hub...'
                echo '========================================'
                

                withCredentials([usernamePassword(credentialsId: 'docker-hub-credentials', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                    bat "docker login -u %DOCKER_USER% -p %DOCKER_PASS%"
                    bat "docker push %DOCKER_HUB_USER%/%IMAGE_NAME%:%BUILD_NUMBER%"
                    bat "docker push %DOCKER_HUB_USER%/%IMAGE_NAME%:latest"
                }
            }
        }

        stage('Deploy Locally (Docker)') {
            steps {
                echo '========================================'
                echo 'Deploying container locally...'
                echo '========================================'
                bat '''
                    @echo off
                    docker ps -q -f name=%CONTAINER_NAME% > container_id.txt
                    set /p CID=<container_id.txt
                    del container_id.txt

                    if not "%CID%"=="" (
                        echo Stopping running container %CONTAINER_NAME%...
                        docker stop %CONTAINER_NAME%
                        docker rm %CONTAINER_NAME%
                    ) else (
                        echo Container %CONTAINER_NAME% is not running.
                    )

                    docker ps -a -q -f name=%CONTAINER_NAME% > container_id.txt
                    set /p CID_ALL=<container_id.txt
                    del container_id.txt

                    if not "%CID_ALL%"=="" (
                        echo Removing stopped container %CONTAINER_NAME%...
                        docker rm %CONTAINER_NAME%
                    )

                    echo Starting new container %CONTAINER_NAME% on port 3000...
                    docker run -d --name %CONTAINER_NAME% -p %PORT_MAPPING% %DOCKER_HUB_USER%/%IMAGE_NAME%:latest
                '''
            }
        }
    }

    post {
        success {
            echo '========================================'
            echo 'REACT CI/CD PIPELINE SUCCESSFUL'
            echo '========================================'
            echo 'Docker Image Built : SUCCESS'
            echo 'Docker Hub Push   : SUCCESS'
            echo 'Local Container   : RUNNING on http://localhost:3000'
            echo '========================================'
        }
        failure {
            echo '========================================'
            echo 'REACT CI/CD PIPELINE FAILED'
            echo '========================================'
            echo 'Please check Jenkins Console Logs.'
            echo '========================================'
        }
    }
}