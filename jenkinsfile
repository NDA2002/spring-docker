pipeline {

    agent any

    environment {
        APP_PORT = "3000"
    }

    stages {

        stage('Install Dependencies') {
            steps {
                echo 'Installing dependencies...'
                bat 'npm ci'
            }
        }

        stage('Build React App') {
            steps {
                echo 'Building React Vite application...'
                bat 'npm run build'
            }
        }

        stage('Deploy Local') {
            steps {

                echo 'Stopping old React server...'

                bat '''
                    for /f "tokens=5" %%a in ('netstat -ano ^| findstr :3000 ^| findstr LISTENING') do taskkill /PID %%a /F
                '''

                echo 'Starting new React application...'

                bat '''
                    start "React-App" /B cmd /c "npx serve -s dist -l 3000"
                '''
            }
        }
    }

    post {

        success {
            echo '========================================'
            echo 'REACT LOCAL DEPLOYMENT SUCCESSFUL'
            echo '========================================'
            echo 'Application: http://localhost:3000'
        }

        failure {
            echo '========================================'
            echo 'REACT DEPLOYMENT FAILED'
            echo '========================================'
            echo 'Check Jenkins Console Output'
        }
    }
}