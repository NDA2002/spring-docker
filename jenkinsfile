pipeline {

    agent any

    environment {
        APP_PORT = "3000"
    }

    stages {

        stage('Install Dependencies') {
            steps {
                echo 'Installing dependencies...'
                bat 'npm ci'
            }
        }

        stage('Build React App') {
            steps {
                echo 'Building React Vite application...'
                bat 'npm run build'
            }
        }

        stage('Deploy Local') {
            steps {

                echo 'Checking port 3000...'

                bat '''
                    netstat -ano | findstr :3000 | findstr LISTENING > nul

                    if %ERRORLEVEL% EQU 0 (
                        echo Port 3000 is in use.
                        echo Stopping old React server...

                        for /f "tokens=5" %%a in ('netstat -ano ^| findstr :3000 ^| findstr LISTENING') do (
                            taskkill /PID %%a /F
                        )
                    ) else (
                        echo No old React server found.
                    )

                    exit /b 0
                '''

                echo 'Starting new React application...'

                bat '''
                    start "React-App" /B cmd /c "npx serve -s dist -l %APP_PORT%"
                '''

                echo 'React application deployed successfully.'
            }
        }
    }

    post {

        success {
            echo '========================================'
            echo 'REACT LOCAL DEPLOYMENT SUCCESSFUL'
            echo '========================================'
            echo 'Application: http://localhost:3000'
            echo '========================================'
        }

        failure {
            echo '========================================'
            echo 'REACT DEPLOYMENT FAILED'
            echo '========================================'
            echo 'Check Jenkins Console Output'
            echo '========================================'
        }
    }
}