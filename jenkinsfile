pipeline {

    agent any

    environment {
        APP_PORT = "3000"
    }

    stages {

        stage('Install Dependencies') {
            steps {
                echo '========================================'
                echo 'Installing npm dependencies...'
                echo '========================================'

                bat 'npm ci'
            }
        }

        stage('Build React App') {
            steps {
                echo '========================================'
                echo 'Building React Vite application...'
                echo '========================================'

                bat 'npm run build'
            }
        }

        stage('Deploy Local') {
            steps {

                echo '========================================'
                echo 'Checking port 3000...'
                echo '========================================'

                bat '''
                    netstat -ano | findstr :3000 | findstr LISTENING

                    if %ERRORLEVEL% EQU 0 (
                        echo Port 3000 is currently in use.
                        echo Stopping old React server...

                        for /f "tokens=5" %%a in ('netstat -ano ^| findstr :3000 ^| findstr LISTENING') do (
                            echo Stopping process %%a
                            taskkill /PID %%a /F
                        )
                    ) else (
                        echo No old React server found.
                    )

                    exit /b 0
                '''

                echo '========================================'
                echo 'Starting new React application...'
                echo '========================================'

                bat '''
                    set JENKINS_NODE_COOKIE=dontKillMe
                    start "React-App" /B cmd /c "npx serve -s dist -l %APP_PORT%"
                '''

                echo '========================================'
                echo 'Waiting for React server...'
                echo '========================================'

                bat '''
                    ping 127.0.0.1 -n 6 > nul
                '''

                echo '========================================'
                echo 'Checking React application...'
                echo '========================================'

                bat '''
                    curl --fail http://localhost:%APP_PORT%
                '''

                echo '========================================'
                echo 'React application deployed successfully.'
                echo 'URL: http://localhost:3000'
                echo '========================================'
            }
        }
    }

    post {

        success {
            echo '========================================'
            echo 'REACT CI/CD PIPELINE SUCCESSFUL'
            echo '========================================'
            echo 'Dependencies installed : SUCCESS'
            echo 'React build            : SUCCESS'
            echo 'Local deployment       : SUCCESS'
            echo 'Application URL        : http://localhost:3000'
            echo '========================================'
        }

        failure {
            echo '========================================'
            echo 'REACT CI/CD PIPELINE FAILED'
            echo '========================================'
            echo 'Please check Jenkins Console Output.'
            echo '========================================'
        }
    }
}